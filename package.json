{
  "name": "fiestaboard-auth",
  "private": true,
  "description": "Static OAuth redirect relay for self-hosted FiestaBoard installs (fiestaboard.app/auth)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/board-address.test.js",
    "test:dist": "node --test tests/dist.test.js"
  },
  "dependencies": {
    "@fiestaboard/ui": "7.0.0",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
